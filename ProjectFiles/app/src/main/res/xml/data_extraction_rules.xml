<?xml version="1.0" encoding="utf-8"?>
<!-- Timer state (trigger time, active flag) is device-specific: a restored value would have no alarm behind it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="widget_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="widget_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
