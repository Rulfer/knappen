<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Knappen" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="Theme.Knappen.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.Knappen.AppWidgetContainer" parent="Theme.Knappen.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>

    <style name="Theme.Knappen.Dialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:textColor">#FFFFFFFF</item>       <!-- White text -->
        <item name="colorOnSurface">#FFFFFFFF</item>         <!-- White icons/text on surfaces -->
        <item name="colorPrimary">#BB86FC</item>             <!-- Purple accent -->
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowMinWidthMajor">80%</item>
        <item name="android:windowMinWidthMinor">80%</item>
    </style>
    <!--    <style name="Theme.Knappen.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">-->
<!--        <item name="android:windowMinWidthMajor">90%</item>-->
<!--        <item name="android:windowMinWidthMinor">90%</item>-->
<!--    </style>-->

    <!-- Launcher screen (MainActivity) -->
    <style name="Theme.Knappen.Main" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/main_background</item>
        <item name="colorPrimary">#BB86FC</item>
        <item name="colorOnSurface">#FFFFFFFF</item>
    </style>
</resources>